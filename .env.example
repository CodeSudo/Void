# Copy this file to .env and fill in the values. Restart `npm run dev` after changing it.

# Firebase: Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_BUCKET=
VITE_SENDER_ID=
VITE_APP_ID=
VITE_MEASURE_ID=

# JioSaavn home feed, production builds only (npm run dev uses the proxy in vite.config.js).
# The address of your deployed home-proxy project, for example https://your-project.vercel.app/api/home
VITE_HOME_API=

# Optional extra music sources
VITE_SOUNDCLOUD_CLIENT_ID=
VITE_SOUNDCLOUD_CLIENT_SECRET=
VITE_QOBUZ_TOKEN=
VITE_QOBUZ_USER_ID=
VITE_YT_API_BASE=
